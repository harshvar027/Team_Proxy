# === Baari .env — copy to .env and fill in values ===

# First admin account (used by seed.py only)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database
DATABASE_URL=sqlite:///./baari.db

# Session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Server
HOST=0.0.0.0
PORT=8000

# Arrival buffer minutes (subtracted from wait estimate for "arrive at" time)
ARRIVAL_BUFFER_MINUTES=15

# Reminder threshold: notify patient when estimate shifts by this many minutes
REMINDER_THRESHOLD_MINUTES=20

# Rate-limit: max login attempts per minute per IP
LOGIN_RATE_LIMIT=5/minute

# Model paths (optional — leave blank to use browser Web Speech API fallback)
WHISPER_MODEL_SIZE=small
WHISPER_MODEL_DIR=./models
PIPER_MODEL_DIR=./models
